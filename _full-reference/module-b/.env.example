APP_NAME="Кухни мира"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost

# Адрес вебхука платёжной системы, который подставляется в payment_link.
# По умолчанию строится автоматически из APP_URL + /recipe-api/webhook
PAYMENT_WEBHOOK_URL=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# База данных MySQL
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kitchens_world
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=public

# Очереди: sync, чтобы событие RecipeCreated отправлялось сразу.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Laravel Reverb (WebSocket) — используется Модулем В для уведомлений.
# Если пакет laravel/reverb недоступен в офлайн-кэше composer,
# переключите BROADCAST_CONNECTION=log (событие всё равно будет сформировано).
# ---------------------------------------------------------------------------
REVERB_APP_ID=100000
REVERB_APP_KEY=kitchens-world-key
REVERB_APP_SECRET=kitchens-world-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Шрифт для водяного знака (путь к TTF). Если не найден — используется
# встроенный растровый шрифт GD.
WATERMARK_FONT=
